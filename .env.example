DEBUG=True
SECRET_KEY=your-django-secret-key-here

# PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres:password@localhost:5432/agronexus
# For Supabase: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# JWT
JWT_SIGNING_KEY=your-jwt-signing-key
# For Supabase JWT validation: set this to your Supabase JWT secret (Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# Email (optional — for alert notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=AgroNexus <noreply@agronexus.io>

# File storage (local or S3)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

ALLOWED_HOSTS=localhost,127.0.0.1
