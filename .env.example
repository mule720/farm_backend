# ─────────────────────────────────────────────────────────────────────────────
# AgroNexus Backend — Environment Variables
# Copy this file to .env and fill in your values for local development.
# Production secrets are stored in Kubernetes secrets (see k8s/secrets.yaml).
# ─────────────────────────────────────────────────────────────────────────────

# Django core
DEBUG=True
SECRET_KEY=your-django-secret-key-at-least-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for dev, PostgreSQL for production)
# Dev:  leave blank → defaults to db.sqlite3
# Prod: set via K8s secret (Cloud SQL socket URL)
# DATABASE_URL=postgresql://agronexus_user:password@localhost:5432/agronexus

# JWT authentication
JWT_SIGNING_KEY=your-jwt-signing-key-32-hex-chars

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# CORS (frontend origins allowed to call the GraphQL API)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8090,http://localhost:5173

# Google Cloud Storage (production media files — leave blank for local dev)
GCS_MEDIA_BUCKET=

# AI (Anthropic Claude — used by the intelligence engine)
ANTHROPIC_API_KEY=

# Email (SendGrid for production, console backend for dev)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=AgroNexus <noreply@yourdomain.com>
